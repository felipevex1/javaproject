<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="361.0" prefWidth="691.0" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.spectral.gui.GuiContaSalario">
   <children>
      <VBox prefHeight="361.0" prefWidth="221.0">
         <children>
            <ListView
               fx:id="lstContas"
               onKeyPressed="#lstContasKeyPressed"
               onMouseClicked="#lstContasMouseClicked"
               prefHeight="283.0"
               prefWidth="221.0">
               <VBox.margin>
                  <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
               </VBox.margin>
            </ListView>
            <HBox alignment="TOP_RIGHT" prefHeight="72.0" prefWidth="221.0" spacing="10.0">
               <children>
                  <Button
                     mnemonicParsing="false"
                     onAction="#btnLancamentoAction"
                     text="Lancamentos" />
                  <Button
                     mnemonicParsing="false"
                     onAction="#btnIncluirAction"
                     text="Incluir" />
                  <Button
                     mnemonicParsing="false"
                     onAction="#btnDeletarAction"
                     text="Deletar" />
               </children>
               <VBox.margin>
                  <Insets right="8.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
      <VBox prefHeight="361.0" prefWidth="470.0">
         <children>
            <GridPane prefHeight="130.0" prefWidth="470.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="250.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Numero" />
                  <Label text="Saldo" GridPane.rowIndex="1" />
                  <Label text="Cliente" GridPane.rowIndex="2" />
                  <TextField fx:id="txtNumero" editable="false" GridPane.columnIndex="1" />
                  <TextField fx:id="txtSaldo" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <ComboBox fx:id="cmbCliente" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               </children>
               <VBox.margin>
                  <Insets left="8.0" right="8.0" />
               </VBox.margin>
            </GridPane>
            <HBox alignment="TOP_RIGHT" prefHeight="51.0" prefWidth="470.0" spacing="10.0">
               <children>
                  <Button
                     fx:id="btnGravar"
                     mnemonicParsing="false"
                     onAction="#btnGravarAction"
                     disable="true"
                     text="Gravar" />
               </children>
               <VBox.margin>
                  <Insets right="8.0" />
               </VBox.margin>
            </HBox>
         </children>
         <HBox.margin>
            <Insets right="8.0" />
         </HBox.margin>
      </VBox>
   </children>
</HBox>
